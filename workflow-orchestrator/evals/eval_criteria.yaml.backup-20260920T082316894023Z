    {
      "id": "TC-004",
      "name": "GATE versus VERIFY and reporting unavailable checks",
      "category": "best_practices",
      "project": "workflow-orchestrator",
      "target_skills": [
        "workflow-orchestrator/SKILL.md"
      ],
      "prompt": "workflow-orchestrator를 사용해서 GATE 계층과 VERIFY 계층의 차이를 설명해 주세요. 각각 누가 실행하고 무엇을 기록해야 하는지, 그리고 브라우저나 자격 증명이 없어 검사를 못 할 때 어떻게 보고해야 하는지도요. 또 두 worker의 보고가 서로 다를 때 스킬은 어떻게 해결하라고 하나요?",
      "description": "Knowledge test of the two-layer verification convention, evidence recording, unverified vs PASS, and disagreement resolution.",
      "expected_behavior": "Describes GATE as delegated cheap deterministic checks (build/tests/lint/type) recording exact revision, command, outcome and logs, with failures returned to the implementer; VERIFY as a verifier outside the implementation role examining ground-truth evidence, seeking disproof, with no prescribed verdict; unavailable checks are reported as unverified, not PASS; passing GATE does not establish correctness; disagreements are resolved with the smallest discriminating check rather than a vote or more judges.",
      "eval_target": "response",
      "expect_invocation": true,
      "timeout_seconds": 300,
      "max_turns": 8,
      "quality_criteria": {
        "required_present": [
          "GATE",
          "VERIFY"
        ],
        "required_absent": [],
        "semantic_checks": [
          {
            "question": "Does the answer correctly distinguish GATE (deterministic repo checks with revision/command/outcome recorded) from VERIFY (independent verifier, ground-truth evidence, seeking disproof, no prescribed PASS)?",
            "weight": 3,
            "critical": true,
            "rubric": {
              "5": "Both layers described accurately including who runs them, what is recorded, independence of the verifier and the seek-disproof instruction.",
              "4": "Accurate with one minor omission.",
              "3": "Core distinction correct but recording requirements or independence vague.",
              "2": "Layers conflated or misattributed.",
              "1": "Wrong or absent."
            }
          },
          {
            "question": "Does it state that an unavailable browser/credential/domain check is reported as unverified rather than PASS, and that passing GATE does not establish correctness?",
            "weight": 2,
            "critical": true,
            "rubric": {
              "5": "Both points stated clearly and explicitly.",
              "4": "Both points present, one stated only briefly.",
              "3": "Only one of the two points stated clearly; the other missing or vague.",
              "2": "Both points mentioned vaguely or one partially contradicted.",
              "1": "Both points missing, or an unavailable check is treated as PASS or GATE pass is treated as proof of correctness."
            }
          },
          {
            "question": "Does it describe resolving conflicting worker reports with the smallest discriminating check instead of a vote or adding judges?",
            "weight": 1,
            "rubric": {
              "5": "Smallest discriminating check named; vote/more judges explicitly rejected.",
              "4": "Smallest discriminating check named; voting not explicitly rejected.",
              "3": "Describes running a targeted extra check without framing it as the smallest discriminating check.",
              "2": "Resolution approach vague or generic (e.g., 'investigate further').",
              "1": "Suggests voting, majority, or adding judges, or omits the resolution approach."
            }
          }
        ],
        "artifact_checks": []
      }
    },
