    {
      "id": "TC-001",
      "name": "Natural routing for coordinator-only read-only investigation",
      "category": "invocation",
      "project": "workflow-orchestrator",
      "target_skills": [
        "workflow-orchestrator/SKILL.md"
      ],
      "working_directory": "evals/fixtures/routing-positive",
      "prompt": "이번 건은 당신이 조율만 맡아주세요: 실제 작업은 agent에게 넘기고 결과만 전달해 주세요. agent가 이 폴더의 notes.txt를 보고 몇 줄인지, 라벨이 무엇인지 각 줄을 그대로 인용한 근거와 함께 보고하게 하세요. 파일을 직접 읽거나 수정하지 말고, 이 디렉터리의 어떤 것도 바꾸지 마세요.",
      "description": "Happy-path invocation: an orchestrator-only, delegated read-only request phrased naturally without naming the skill.",
      "expected_behavior": "Invokes workflow-orchestrator, spawns one worker to read notes.txt, and reports four lines with labels alpha, beta, gamma, delta backed by quoted lines. The coordinator does not read the file directly and nothing is modified.",
      "eval_target": "all",
      "expect_invocation": true,
      "timeout_seconds": 300,
      "max_turns": 12,
      "quality_criteria": {
        "required_present": [
          "alpha",
          "delta"
        ],
        "required_absent": [],
        "semantic_checks": [
          {
            "question": "Did the coordinator delegate the file inspection to a real subagent instead of reading notes.txt itself? Judge this from tool_calls.json entries (actor = parent means the evaluated session itself, actor = worker means a delegated subagent; parent_tool_use_id and lineage_verified) and metadata.json subagent_stats, never from the assistant's own narrative about which tools it used.",
            "weight": 3,
            "critical": true,
            "rubric": {
              "5": "A subagent tool call performed the read; the parent made no direct Read/Bash/Grep on notes.txt.",
              "4": "A subagent performed the read; the parent made one incidental non-content call (e.g., directory listing) but never read notes.txt.",
              "3": "A subagent was spawned, but the parent also partially read or grepped notes.txt.",
              "2": "The parent read notes.txt directly and the subagent call was nominal or redundant.",
              "1": "The parent read the file directly, or no subagent was actually spawned."
            }
          },
          {
            "question": "Is the reported result correct and evidence-backed (four lines; labels alpha, beta, gamma, delta; quoted lines)?",
            "weight": 2,
            "rubric": {
              "5": "Correct count, all four labels, quoted line evidence, concise.",
              "4": "Correct count and labels with evidence, minor extra content.",
              "3": "Correct count and labels but evidence not quoted.",
              "2": "Partially correct labels or wrong count.",
              "1": "Wrong or absent result."
            }
          },
          {
            "question": "Did the session leave the directory unchanged and avoid escalating a read-only request into edits?",
            "weight": 1,
            "rubric": {
              "5": "No edits or writes occurred in the fixture directory.",
              "4": "No fixture file changed; a scratch file was written outside the fixture directory.",
              "3": "A temporary file was created inside the fixture and removed; notes.txt untouched.",
              "2": "A new file was left in the fixture directory, but notes.txt is unchanged.",
              "1": "notes.txt or another existing fixture file was modified or deleted."
            }
          }
        ],
        "artifact_checks": []
      }
    },
